{
  "openapi": "3.1.0",
  "info": {
    "title": "FASTQ Quality Trimmer Auxiliary Supervisor API",
    "version": "1.0.0",
    "description": "Mock rule-based supervisor API for demonstrations. These endpoints do not trim FASTQ reads or perform clinical validation."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory mock supervisor counts (JSON)",
        "responses": {
          "200": {
            "description": "Metric counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate mock supervisor task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemTaskPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock consensus dossier"
          },
          "422": {
            "description": "Payload validation or detected sensitive identifier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic mock response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "422": {
            "description": "Detected sensitive identifier"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Get in-memory HMAC chain snapshot",
        "responses": {
          "200": {
            "description": "Current audit trail and integrity result"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SystemTaskPayload": {
        "type": "object",
        "required": [
          "task_id",
          "target_identifier",
          "primary_metric"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "target_identifier": {
            "type": "string"
          },
          "primary_metric": {
            "type": "number"
          },
          "secondary_metric": {
            "type": "number",
            "default": 0
          },
          "status_descriptor": {
            "type": "string",
            "default": "NOMINAL"
          },
          "is_critical_flag": {
            "type": "boolean",
            "default": false
          },
          "attributes": {
            "type": "object"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
