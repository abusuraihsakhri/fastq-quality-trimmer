# Fastq Quality Trimmer Environment Configuration
# Copy this file to .env and update the values

# HMAC-SHA256 Audit Trail Secret Key
# IMPORTANT: Change this to a strong random value in production!
# Generate with: python -c "import os; print(os.urandom(32).hex())"
AUDIT_SECRET_KEY=change-me-to-a-strong-random-key

# LLM Provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock
